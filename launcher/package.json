{
  "name": "storm-front",
  "productName": "StormFront",
  "author": "Donyxxx",
  "description": "Launcher StormFront",
  "private": true,
  "version": "1.1.5",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "dompurify": "^3.3.1",
    "electron-updater": "^6.6.2",
    "eml-lib": "2.0.0-beta.20",
    "marked": "^17.0.1"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-electron": "^1.1.1"
  },
  "build": {
    "appId": "ru.stormfront.launcher",
    "productName": "StormFront",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "build/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "StormFront"
    },
    "publish": {
      "provider": "generic",
      "url": "https://lastfront.ru/"
    }
  }
}